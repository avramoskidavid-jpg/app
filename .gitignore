# ---- Backend (.NET) ----
backend/**/bin/
backend/**/obj/
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal
# Environment-specific appsettings can hold real local secrets (JWT keys, connection
# strings) - never commit them. The base appsettings.json (placeholders only) stays tracked.
backend/**/appsettings.*.json
!backend/**/appsettings.json
*.user
*.suo
.vs/

# ---- Frontend (Node / Vite) ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Docker ----
# Local overrides for docker-compose; never commit real secrets in one of these.
docker-compose.override.yml
.env
.env.*
!frontend/.env
!.env.example

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
